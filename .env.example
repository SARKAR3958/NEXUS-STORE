# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
JWT_SECRET="super_secret_jwt_key_for_auth"
NEXTAUTH_SECRET="super_secret_nextauth_key"
STRIPE_SECRET="sk_test_..."

# ImgBB API Key for direct CDN image hosting
VITE_IMGBB_API_KEY="2d1f95c478a876793e150937a0774da3"

# Frontend OpenRouter key (public in the browser; use only a limited free key)
VITE_OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Optional: Email SMTP Configuration (for live email dispatch)
# Works with Gmail App Password, Resend, Brevo, SendGrid, Mailgun, or custom domain SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"NEXORA Security" <security@nexora.market>'
# Or Gmail simple configuration:
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
